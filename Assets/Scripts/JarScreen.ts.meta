    - "// @input SceneObject cameraObject {\"hint\":\"Scene \\\"Camera Object\\\" — the Jar panels are placed in front of the user each time this screen opens (yaw-only, not billboarded). Optional; falls back to the screen root's authored position if unwired.\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Copy"}'
    - '// @input string backLabel = "Back to Home"'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float panelDistanceCm = -100 {"hint":"Local Z of the Jar panel tree relative to this screen root (cm, negative = in front)."}'
    - '// @input float sphereDiameterCm = 7 {"hint":"Diameter of each day-sphere in cm."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - '// @input bool debugSeedDays {"hint":"Preview-only: if the store has 0 saved days when this screen opens, seed 3 fake days so the layout is screenshot-able. Leave OFF for real use."}'
    - "// @input bool debugOpenFirstDay {\"hint\":\"Preview-only: auto-open the first day's detail view a moment after the Jar builds (no hand tap needed), so the detail + Reveal can be screenshotted. Leave OFF for real use.\"}"
    - '// @input bool debugClearSavedDays {"hint":"Preview-only ONE-SHOT: wipe the persistent traceJournal.days store when this screen opens (clears test pollution). Turn back OFF after one run."}'
    - '// @ui {"widget":"group_end"}'
