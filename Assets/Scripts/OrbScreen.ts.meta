  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">OrbScreen — fold into a glowing sphere, save the day (§11)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 flowManager {"hint":"FlowManager — Done -> Launch (Home)."}'
    - '// @input AssignableType_2 journalSession {"hint":"JournalSession — reads getEntry() to fold into the sphere + persist."}'
    - '// @input Asset.RenderMesh orbMesh {"hint":"Sphere mesh (wire to MarkerSphereMesh.mesh)."}'
    - '// @input Asset.Material orbMat {"hint":"Orb shader material — cloned + tinted per entry (wire to Materials/OrbGlass.mat). A real shader graph (UberPBR) with Fresnel rim-light + normal-map features toggled on — see class doc."}'
    - "// @input SceneObject sphereParent {\"hint\":\"ALWAYS-ON holder a 'Placed' sphere is parented to — this script's own SceneObject is the toggled OrbRoot (ScreenRouter disables it off-screen), so a sphere left there would vanish instead of staying visible. Wire to an always-enabled object (e.g. CardSpawner's/OrbSpawner). Falls back to this.sceneObject (and so still vanishes/hides) if unwired.\"}"
    - "// @input SceneObject cameraObject {\"hint\":\"The scene \\\"Camera Object\\\". Editor/Preview placement-ray fallback only — device placement uses the dominant hand's own targeting ray. Optional; the \\\"Drop Here (Preview)\\\" button just won't work in Preview if unwired.\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Copy"}'
    - '// @input string savedPrompt = "Today is folded away."'
    - '// @input string keepPrivateLabel = "Keep Private"'
    - '// @input string placeLabel = "Place in Space"'
    - '// @input string doneLabel = "Okay"'
    - '// @input string placeHintLabel = "Pinch to place" {"hint":"Shown ON the floating sphere while it follows your hand (2026-09-05 — replaces the old instruction panel)."}'
    - '// @input string placeConfirmLabel = "Confirm"'
    - '// @input string placeResetLabel = "Reset"'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float panelDistanceCm = -100 {"hint":"Local Z of the Orb panel relative to this screen root (cm, negative = in front)."}'
    - '// @input float sphereDiameterCm = 18 {"hint":"Sphere diameter in cm."}'
    - "// @input float placeDistanceCm = 60 {\"hint\":\"Distance (cm) out along the hand's/camera's forward ray the sphere floats while choosing where to place it.\", \"widget\":\"slider\", \"min\":20, \"max\":150, \"step\":1}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - '// @input bool debugAutopilot {"hint":"Preview-only: once the sphere pops in, tap Keep Private then Done automatically. Leave OFF for real use."}'
    - '// @input bool debugAutopilotPlace {"hint":"Preview-only: once the sphere pops in, begin placement, finalize it (stand-in for a pinch — Editor/Preview has no hand tracking) then Done automatically. Ignored if debugAutopilot is also on. Leave OFF for real use."}'
    - '// @ui {"widget":"group_end"}'
