  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MemoryCardSpawner — spatial Memory Cards + card actions</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input AssignableType_1 flowManager {\"hint\":\"FlowManager — screen transitions for Scan Again / Add Another Trace / Create Today's Journal.\"}"
    - '// @input AssignableType_2 journalSession {"hint":"JournalSession — live evidence store the Keep / Retake / Remove buttons and the tap-to-edit-label chooser mutate."}'
    - '// @input SceneObject cameraObject {"hint":"Scene \"Camera Object\" — cards billboard to face it at spawn."}'
    - "// @input AssignableType_3 momentFlow {\"hint\":\"MomentEmotionReflect — Keep hands off to its begin(order) for the per-moment emotion + question + 'Moment saved' sub-flow (§4-§6).\"}"
    - '// @input Asset.RenderMesh markerMesh {"hint":"Marker sphere mesh (wire to MarkerSphereMesh.mesh)."}'
    - '// @input Asset.Material markerMat {"hint":"Base material for the marker + luminous line (wire to MarkerWhite.mat)."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Copy"}'
    - '// @input string confirmPrompt {"hint":"Shown on the card under the title. Empty by default (2026-09-05 — the \"is it correct?\" prompt was removed)."}'
    - '// @input string keptNote = "Kept for today." {"hint":"Replaces the confirm prompt once the moment is kept."}'
    - '// @input string ocrCaption = "Extracted text:" {"hint":"Caption in front of the extracted-text line."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - // @input float cardWidthCm = 34
    - // @input float cardHeightCm = 72
    - '// @input float cardTowardCameraCm = 26 {"hint":"Card offset from the marker toward the camera (cm)."}'
    - '// @input float cardUpCm = 34 {"hint":"Card offset above the marker (cm)."}'
    - '// @input float cardGapCm = 7 {"hint":"Gap (cm) between the marker sphere and the bottom edge of the card, along the shared plane."}'
    - '// @input float thumbHeightCm = 10 {"hint":"Thumbnail height inside the card (cm)."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - '// @input bool debugAutopilot {"hint":"Debug: after the first card spawns, auto-run Keep -> Change Label -> pick alternative on it (no hand taps needed in Preview). Leave OFF for real use."}'
    - '// @input bool debugAutoKeepFirstCard {"hint":"Debug: after the first card spawns, just tap Keep on it (→ hands off to the §4-§6 moment sub-flow). Use with MomentEmotionReflect.debugAutopilot to verify §4-§6 in Preview. Leave OFF for real use."}'
    - '// @input bool debugAutopilotRemove {"hint":"Debug: when debugAutopilot is on, also Remove the card at the end (exercises marker/line teardown + return-to-Scan)."}'
    - '// @input bool debugSeedConfirm {"hint":"Debug: on start, seed JournalSession with two synthetic kept traces and jump Launch -> Card -> Confirm (no capture / Gemini needed) so the Confirm screen can be exercised in Preview. Leave OFF for real use."}'
    - '// @input bool debugSeedWithDateLoc {"hint":"Debug: with debugSeedConfirm on, give synthetic trace #1 a detected date + location so the opt-in path can be tested. OFF = neither seeded trace has a date/location (tests the empty path)."}'
    - '// @ui {"widget":"group_end"}'
