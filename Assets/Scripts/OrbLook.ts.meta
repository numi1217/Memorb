  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">OrbLook — Memory Orb look + live debug preview (§11)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References (debug preview only)"}'
    - '// @input Asset.RenderMesh orbMesh {"hint":"Sphere mesh for the debug preview (wire to MarkerSphereMesh.mesh — same asset OrbScreen.orbMesh uses)."}'
    - '// @input Asset.Material orbMat {"hint":"Orb material for the debug preview — wire to Vertex Distortion.mat, the SAME asset OrbScreen.orbMat uses."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Orb look (shared by the real orb + the debug preview)"}'
    - "// @input float waveStrength = 0.2 {\"hint\":\"How far the surface vertices wobble (Vertex Distortion 'strength').\", \"widget\":\"slider\", \"min\":0, \"max\":1, \"step\":0.01}"
    - "// @input float waveSpeed = 2.9 {\"hint\":\"How fast the wobble animates (Vertex Distortion 'animatedSpeed').\", \"widget\":\"slider\", \"min\":0, \"max\":20, \"step\":0.1}"
    - "// @input float noiseScale = 0.2 {\"hint\":\"Noise scale of the wobble — smaller = broader swells, larger = finer ripples (Vertex Distortion 'noiseScale').\", \"widget\":\"slider\", \"min\":0, \"max\":1, \"step\":0.01}"
    - '// @input float rotationSpeedDegPerSec = 12 {"hint":"Degrees/second the whole orb slowly spins on top of the surface wobble.", "widget":"slider", "min":-60, "max":60, "step":1}'
    - "// @input float matteRoughness = 0.9 {\"hint\":\"Surface roughness — 1 = fully matte (no specular highlight, 'matte paper'), 0 = glossy/plastic.\", \"widget\":\"slider\", \"min\":0, \"max\":1, \"step\":0.01}"
    - '// @input float glowColorAmount = 0.14 {"hint":"Self-glow tinted with the day colour — makes the orb read as luminous. 0 = none.", "widget":"slider", "min":0, "max":0.6, "step":0.01}'
    - '// @input float glowWhiteAmount {"hint":"Extra white added to the self-glow — pushes the lit side toward a white core.", "widget":"slider", "min":0, "max":0.4, "step":0.01}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - '// @input bool debugPreviewOrb {"hint":"Preview-only: shows a live-tunable orb immediately, independent of the save flow, re-applying the sliders above every frame. Leave OFF for real use."}'
    - "// @input string debugOrbColorHex = \"#5B8DEF\" {\"hint\":\"Orb colour used ONLY by the debug preview (the real orb always uses the day's feeling colour).\"}"
    - '// @ui {"widget":"group_end"}'
